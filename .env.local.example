# Kostenloser API-Key von https://the-odds-api.com (500 Requests/Monat)
# Datei kopieren nach .env.local und Key eintragen:
VITE_ODDS_API_KEY=dein_key_hier

# Optional: Fallback-Datenquelle, falls OpenLigaDB ausfaellt.
# Kostenloser API-Key von https://www.football-data.org (10 Requests/Minute)
VITE_FOOTBALLDATA_API_KEY=dein_key_hier
